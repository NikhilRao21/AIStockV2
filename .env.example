ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
AI_API_KEY=your_ai_provider_key
AI_BASE_URL=https://your-provider.com/v1    # must end in /v1
AI_MODEL=qwen/qwen3-32b                     # final buy/sell decision
AI_FAST_MODEL=deepseek/deepseek-v4-flash-0731  # optional: sentiment, bull/bear theses, reviews (defaults to AI_MODEL)
LANGSEARCH_API_KEY=your_langsearch_key      # free at langsearch.com, used for broad news discovery
# Optional
# REFLECTION_PATH=summaryReflection.txt     # learned playbook, updated after each review
# DB_PATH=trading_system.db
# ALLOW_TRADING_WHEN_CLOSED=1               # send orders outside market hours (testing only)
